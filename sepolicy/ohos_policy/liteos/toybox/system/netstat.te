pc_only(`
    allow netstat self:capability { sys_ptrace dac_read_search };
    allow netstat domain:dir { getattr open read search };
    allow netstat domain:file { getattr open read };
    allow netstat domain:lnk_file { read };
    allow netstat hmdfs:dir { getattr open read search };
    allow netstat data_user_file:dir { getattr open read search };
    allow netstat fs_attr:file { getattr };
    allow netstat file_attr:file { getattr };
    allow netstat devpts:chr_file { getattr read write };
    allow netstat tty_device:chr_file { write };
    allow netstat render_service:unix_stream_socket { read write };

    allow netstat proc_net:file { open read };
    allow netstat proc_net_tcp_udp:file { open read };
    allow netstat dev_unix_socket:dir { search };

    # for dns resolution
    allow netstat netsysnative:unix_stream_socket { connectto };
    allow netstat self:udp_socket { read write create bind };
    allow netstat node:udp_socket { node_bind };
')
